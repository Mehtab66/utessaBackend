# Copy this file to .env and fill in the values. .env is git-ignored — never commit it.
# Every variable without a default in application.properties MUST be set, or the backend will not start.

# ── Database (local PostgreSQL: CREATE DATABASE utessa_crm;) ─────────────
DB_USERNAME=postgres
DB_PASSWORD=change-me

SERVER_PORT=8080

# ── Login sessions ──────────────────────────────────────────────────────
# HMAC signing key for JWTs. Must be at least 32 bytes (64+ random hex chars recommended).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(64))"
# Changing it signs everyone out.
JWT_SECRET=

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Google sign-in ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) for verification codes ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Optional: one-time sample data seeding ──────────────────────────────
SEED_ORG_SLUG=
SEED_OWNER_EMAIL=

# ── Stripe Billing ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Each value may be a Price ID (price_...) or a Product ID (prod_...); a product ID uses its default price.
STRIPE_PRICE_CRM_MONTHLY=
STRIPE_PRICE_CRM_YEARLY=
STRIPE_PRICE_OPS_MONTHLY=
STRIPE_PRICE_OPS_YEARLY=
STRIPE_PRICE_MKT_MONTHLY=
STRIPE_PRICE_MKT_YEARLY=
STRIPE_PRICE_TC_MONTHLY=
STRIPE_PRICE_TC_YEARLY=
STRIPE_PRICE_SEAT_MONTHLY=
STRIPE_PRICE_SEAT_YEARLY=
STRIPE_CURRENCY=usd
# Where Stripe Checkout returns the customer (the Utessa frontend)
BILLING_FRONTEND_URL=http://localhost:5173
# Optional billing settings (defaults shown)
BILLING_TRIAL_MAX_MEMBERS=10
BILLING_GRACE_PERIOD_DAYS=7
BILLING_RECONCILE_INTERVAL_MS=120000
