# Copy this file to .env and fill in the values. .env is git-ignored — never commit it.
# Every variable without a default in application.properties MUST be set, or the backend will not start.

# ── Database (local PostgreSQL: CREATE DATABASE utessa_crm;) ─────────────
DB_USERNAME=postgres
DB_PASSWORD=change-me

SERVER_PORT=8080

# ── Login sessions ──────────────────────────────────────────────────────
# HMAC signing key for JWTs. Must be at least 32 bytes (64+ random hex chars recommended).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(64))"
# Changing it signs everyone out.
JWT_SECRET=

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174

# ── Google sign-in ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) for verification codes ─────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Optional: one-time sample data seeding ──────────────────────────────
SEED_ORG_SLUG=
SEED_OWNER_EMAIL=
